NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sermon_api

# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Create/alter tables on boot. Convenient for development; use migrations in production.
DB_SYNC=true

# Comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# Seconds to cache sermon list responses
SERMON_CACHE_TTL=60

# Used by `npm run create-admin`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Optional: required only for real profile photo uploads/removals.
# Set securely on the backend. Never put these in VITE_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
